# Google OAuth web client (Google Auth Platform > Clients). Redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Auth.js session secret: `openssl rand -base64 32`
AUTH_SECRET=
# 32 random bytes, base64: encrypts Gmail refresh tokens and TypeSafe keys at rest. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# Postgres (Neon, Supabase, or any Postgres)
DATABASE_URL=
# Vercel Cron calls /api/cron with `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=
# Public origin of this deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Jev is bring-your-own-key: each signed-in user adds a TypeSafe key in the dashboard. If you also set a
# house key here, the one account whose email matches OWNER_EMAIL uses it without adding its own.
TYPESAFE_API_KEY=
OWNER_EMAIL=
# Optional model pins (TypeSafe serves jev-latest by default)
TYPESAFE_MODEL=
TYPESAFE_GRADER_MODEL=
